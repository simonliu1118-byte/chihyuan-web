{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "__CF_WORKER_NAME__",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-28",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__CF_D1_DATABASE_NAME__",
      "database_id": "__CF_D1_DATABASE_ID__",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "IDENTITY",
      "service": "__CF_IDENTITY_SERVICE__"
    }
  ],
  "vars": {
    "IDENTITY_LOGIN_APPLICATION": "__CF_IDENTITY_LOGIN_APPLICATION__"
  }
}
