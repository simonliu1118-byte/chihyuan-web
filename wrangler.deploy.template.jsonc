{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "__CF_WORKER_NAME__",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "__CF_PUBLIC_HOSTNAME__",
      "custom_domain": true
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__CF_D1_DATABASE_NAME__",
      "database_id": "__CF_D1_DATABASE_ID__",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "IDENTITY",
      "service": "__CF_IDENTITY_SERVICE__"
    }
  ],
  "vars": {
    "IDENTITY_CONSUMER_VERSION": "__CYID_CONSUMER_VERSION__",
    "SOURCE_VERSION": "__CYWEB_VERSION__",
    "IDENTITY_APPLICATION_ID": "__CF_IDENTITY_APPLICATION_ID__",
    "IDENTITY_WORKSPACE_ID": "__CF_IDENTITY_WORKSPACE_ID__"
  }
}
