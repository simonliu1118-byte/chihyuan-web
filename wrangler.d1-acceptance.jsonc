{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chihyuan-web-d1-acceptance",
  "main": "./worker/acceptance/d1-local-acceptance.ts",
  "compatibility_date": "2026-09-27",
  "r2_buckets": [{ "binding": "BACKUP_R2", "bucket_name": "cyweb-ephemeral-acceptance" }],
  "d1_databases": [
    {
      "binding": "REHEARSAL_DB",
      "database_name": "cyweb-rehearsal-acceptance",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "migrations"
    },
    {
      "binding": "DB",
      "database_name": "cyweb-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    },
    {
      "binding": "RESTORE_DB",
      "database_name": "cyweb-restore-acceptance",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ]
}
