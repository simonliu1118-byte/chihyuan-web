{
  "name": "chihyuan-web",
  "version": "0.1.12",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "validate:source": "python scripts/validate_schema.py && python scripts/validate_foundation.py && python scripts/validate_identity_foundation.py && python scripts/validate_audit_foundation.py",
    "preview": "npm run build && vite preview",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrations:local": "wrangler d1 migrations list DB --local"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.60.2",
    "@cloudflare/workers-types": "5.20260926.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "wrangler": "4.140.0"
  }
}
